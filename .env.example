# Copie para .env e configure sua chave antes da análise real.
# Não inclua o arquivo .env em commits.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_RPM_BUDGET=10
GEMINI_TPM_BUDGET=100000
GEMINI_RPD_BUDGET=500
GEMINI_OUTPUT_TOKEN_BUDGET=8192
# Opcional: identificador comum se outros clientes usam a mesma cota do projeto.
# GEMINI_QUOTA_GROUP=

# true ativa dados simulados para demonstração; false usa Gemini.
NODE3_MOCK_MODE=false

# Diretórios locais para índice vetorial e retomada da análise.
CHROMA_PERSIST_DIRECTORY=./data/vector_db
LICIT_CHECKPOINT_DIR=./data/checkpoints


# Observabilidade local: inicie python start_observability.py em outro terminal.
OBSERVABILITY_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_TRACES_SAMPLER_ARG=1.0
APP_ENV=local
# Defina uma senha própria para iniciar o Grafana (usuário admin).
GRAFANA_ADMIN_PASSWORD=
