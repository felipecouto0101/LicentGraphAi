# ============================================
# LicitGraphAi - Environment Variables
# ============================================
# Copie este arquivo para .env e preencha com seus dados reais
# NÃO comite o arquivo .env ao repositório
# ============================================

# Groq API Configuration (Opcional - usa mock mode se não configurado)
GROQ_API_KEY=your_groq_api_key_here
# Obtenha sua chave gratuita em: https://console.groq.com/

# Model Configuration
DEFAULT_MODEL=llama-3.1-8b-instant
# Opções: llama-3.1-8b-instant, llama-3.1-70b-versatile, llama-3.1-8b-preview
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=2000

# Vector Database (ChromaDB)
CHROMA_PERSIST_DIRECTORY=./data/vector_db
CHROMA_COLLECTION_NAME=licitacoes

# Embedding Configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# PDF Processing Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
CHUNK_BY_SECTIONS=true

# API Configuration (Futuro)
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false

# Logging Configuration
LOG_LEVEL=INFO
# Opções: DEBUG, INFO, WARNING, ERROR, CRITICAL

# Node 3 Configuration
NODE3_MOCK_MODE=true
# true = usa modo mock (sem API key)
# false = usa API Groq real (requer GROQ_API_KEY)
