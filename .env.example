# Copie para .env e configure sua chave antes da análise real.
# Não inclua o arquivo .env em commits.
GROQ_API_KEY=your_groq_api_key_here

# Chaves extras opcionais, usadas quando uma chave atinge a cota diária.
# GROQ_API_KEY_2=
# GROQ_API_KEY_3=
# GROQ_API_KEY_4=
# GROQ_API_KEY_5=

# true ativa dados simulados para demonstração; false usa a Groq.
NODE3_MOCK_MODE=false

# Diretórios locais para índice vetorial e retomada da análise.
CHROMA_PERSIST_DIRECTORY=./data/vector_db
LICIT_CHECKPOINT_DIR=./data/checkpoints


# Observabilidade local: inicie compose.observability.yaml antes de habilitar.
OBSERVABILITY_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_TRACES_SAMPLER_ARG=1.0
APP_ENV=local
# Defina uma senha própria para iniciar o Grafana (usuário admin).
GRAFANA_ADMIN_PASSWORD=
